{
  "name": "gymhub",
  "version": "0.1.3",
  "description": "GymHub: allenamenti, nutrizione e abitudini. Offline, open source, senza abbonamento.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3187 --strictPort",
    "build": "vite build && node scripts/offline.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 3187 --strictPort",
    "test": "node --test tests/domain.test.js",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:build": "npm run android:sync && cd android && gradlew.bat assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@playwright/test": "^1.64.1",
    "vite": "^8.3.5"
  },
  "overrides": {
    "glob": "^14.0.2"
  }
}
